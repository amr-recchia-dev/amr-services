# ============================================================
# EMAIL AGENT - Template credenziali
# Copia questo file in .env e compila con i valori reali
# MAI committare .env su git!
# ============================================================

# --- IMAP Register.it ---
IMAP_HOST=mail.register.it
IMAP_PORT=993
IMAP_USER=ordini@amrrecchia.it
IMAP_PASSWORD=LA_TUA_PASSWORD

# --- Monday.com API ---
# Genera token su: https://amr-srl.monday.com/p/admin/tokens
MONDAY_API_TOKEN=eyJhbGciOi...
MONDAY_BOARD_ID=2133436509

# --- Gemini AI ---
# Genera API key su: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# --- Impostazioni Agente ---
# Ogni quanti minuti controllare le email (default: 5)
CHECK_INTERVAL_MINUTES=5

# Cartella IMAP da monitorare
IMAP_FOLDER=INBOX

# ID del gruppo nella board dove creare i nuovi item
# "Richieste commerciali AMR" - recuperato automaticamente se lasci vuoto
MONDAY_GROUP_ID=

# Se True, marcare le email come LETTE dopo l'elaborazione
MARK_AS_READ=True

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
